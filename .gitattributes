# Normalise line endings to LF in the repository and working tree.
* text=auto eol=lf

# Source and docs
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf
*.webmanifest text eol=lf
*.py   text eol=lf

# Binary assets: never touch line endings, never diff
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.pdf   binary
*.blend binary
